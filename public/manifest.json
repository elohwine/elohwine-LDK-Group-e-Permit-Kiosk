{
  "name": "Kiosk ePermit",
  "short_name": "ePermit",
  "description": "Kiosk-friendly e‑Permit application for applying, renewing, and verifying parking permits with offline support and PWA install.",
  "id": "com.kiosk.epermit",
  "start_url": "/?source=pwa",
  "scope": "/",
  "lang": "en-GB",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "fullscreen",
    "standalone"
  ],
  "capture_links": "existing-client-navigate",
  "orientation": "any",
  "dir": "ltr",
  "background_color": "#ffffff",
  "theme_color": "#1374bc",
  "edge_side_panel": {
    "preferred_width": 380,
    "rule_list": [
      {
        "matches": [
          "/*"
        ],
        "entry_points": [
          {
            "title": "Assistant",
            "url": "/?source=sidepanel"
          }
        ]
      }
    ]
  },
  "launch_handler": {
    "client_mode": "focus-existing"
  },
  "share_target": {
    "action": "/share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "files",
          "accept": [
            "image/*",
            "application/*",
            "text/*",
            "*/*"
          ]
        }
      ]
    }
  },
  "file_handlers": [
    {
      "action": "/open-file",
      "accept": {
        "application/json": [
          ".json",
          ".epermit"
        ],
        "text/plain": [
          ".txt"
        ]
      },
      "launch_type": "single-client"
    }
  ],
  "protocol_handlers": [
    {
      "protocol": "web+epermit",
      "url": "/protocol-handler?url=%s"
    }
  ],
  "iarc_rating_id": "pending",
  "categories": [
    "business",
    "utilities",
    "productivity"
  ],
  "icons": [
    {
      "src": "../icons/icon-48.webp",
      "type": "image/png",
      "sizes": "48x48",
      "purpose": "any maskable"
    },
    {
      "src": "../icons/icon-72.webp",
      "type": "image/png",
      "sizes": "72x72",
      "purpose": "any maskable"
    },
    {
      "src": "../icons/icon-96.webp",
      "type": "image/png",
      "sizes": "96x96",
      "purpose": "any maskable"
    },
    {
      "src": "../icons/icon-128.webp",
      "type": "image/png",
      "sizes": "128x128",
      "purpose": "any maskable"
    },
    {
      "src": "../icons/icon-192.webp",
      "type": "image/png",
      "sizes": "192x192",
      "purpose": "any maskable"
    },
    {
      "src": "../icons/icon-256.webp",
      "type": "image/png",
      "sizes": "256x256",
      "purpose": "any maskable"
    },
    {
      "src": "../icons/icon-512.webp",
      "type": "image/png",
      "sizes": "512x512",
      "purpose": "any maskable"
    }
  ],
  "screenshots": [
    {
      "src": "/reference.png",
      "sizes": "1280x720",
      "type": "image/png",
      "label": "Home screen",
      "form_factor": "wide"
    }
  ],
  "related_applications": [
    {
      "platform": "play",
      "url": "https://play.google.com/store/apps/details?id=com.kiosk.epermit",
      "id": "com.kiosk.epermit"
    }
  ],
  "shortcuts": [
    {
      "name": "Apply for Permit",
      "short_name": "Apply",
      "description": "Start a new permit application",
      "url": "/apply",
      "icons": [
        {
          "src": "/icons/shortcut-96.png",
          "sizes": "96x96",
          "type": "image/png",
          "purpose": "any"
        },
        {
          "src": "/icons/shortcut-96-mono.png",
          "sizes": "96x96",
          "type": "image/png",
          "purpose": "monochrome"
        },
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Renew Permit",
      "short_name": "Renew",
      "description": "Renew an existing permit",
      "url": "/renew",
      "icons": [
        {
          "src": "/icons/shortcut-96.png",
          "sizes": "96x96",
          "type": "image/png",
          "purpose": "any"
        },
        {
          "src": "/icons/shortcut-96-mono.png",
          "sizes": "96x96",
          "type": "image/png",
          "purpose": "monochrome"
        },
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    },
    {
      "name": "Verify Permit",
      "short_name": "Verify",
      "description": "Scan or enter a permit to verify",
      "url": "/verify",
      "icons": [
        {
          "src": "/icons/shortcut-96.png",
          "sizes": "96x96",
          "type": "image/png",
          "purpose": "any"
        },
        {
          "src": "/icons/shortcut-96-mono.png",
          "sizes": "96x96",
          "type": "image/png",
          "purpose": "monochrome"
        },
        {
          "src": "/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png",
          "purpose": "any"
        }
      ]
    }
  ],
  "prefer_related_applications": false
}
